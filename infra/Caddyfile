# Bloby managed-instance Caddyfile — baked into the golden AMI at /etc/caddy/Caddyfile.
#
# Each managed box serves exactly ONE bot. Cloudflare (orange-cloud) terminates the
# public TLS for mybot.bloby.bot and proxies to this origin over HTTPS using a
# Cloudflare Origin certificate. Caddy here just:
#   - terminates that origin TLS with the *.bloby.bot Origin cert (15-yr, same on
#     every box — baked into the AMI),
#   - requires Cloudflare's client certificate (Authenticated Origin Pulls) so ONLY
#     Cloudflare can reach the origin, and
#   - reverse-proxies everything (HTTP + WebSocket upgrades) to the supervisor on
#     127.0.0.1:7400.
#
# Set Cloudflare SSL/TLS mode to "Full (strict)" for the bloby.bot zone.

{
	# We use the long-lived Cloudflare Origin cert, not ACME — disable auto-HTTPS.
	auto_https off
	servers {
		# Trust Cloudflare's added headers for the real client IP / proto.
		trusted_proxies static private_ranges
	}
}

# Match all hostnames on :443 — Cloudflare already routed the correct
# mybot.bloby.bot A-record to this box, and AOP guarantees the caller is CF.
https:// {
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key {
		client_auth {
			mode require_and_verify
			# Cloudflare's Authenticated Origin Pulls CA (origin-pull-ca.pem).
			# Caddy 2.8+ syntax; for <2.8 use: trusted_ca_cert_file /etc/caddy/cloudflare-aop.pem
			trust_pool file {
				pem_file /etc/caddy/cloudflare-aop.pem
			}
		}
	}

	# Generous body size for image/audio chat attachments.
	request_body {
		max_size 100MB
	}

	# WebSocket upgrades (chat WS + /app/ws) pass through transparently.
	reverse_proxy 127.0.0.1:7400 {
		# Long-lived streams (chat WS, SSE) must not be cut by a read timeout.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
